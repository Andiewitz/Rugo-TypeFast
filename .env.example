APP_ENV=development
PORT=3001
DATABASE_URL=postgres://kit:kit_dev_password@localhost:5432/kit?sslmode=disable
APP_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# Generate with: go run ./services/user/cmd/keygen
# Leave empty in development to use an ephemeral signing key.
JWT_PRIVATE_KEY=
JWT_KEY_ID=dev-1
JWT_ISSUER=kit-user
JWT_AUDIENCE=kit-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

COOKIE_SECURE=false
COOKIE_DOMAIN=

MAILER=smtp
SMTP_ADDR=localhost:1025
MAIL_FROM=no-reply@kit.local
# starttls requires the relay to upgrade, opportunistic upgrades when offered,
# none sends verification and reset links in clear text. Use none only locally.
SMTP_TLS=none

# Shared with trusted callers of POST /internal/v1/authz/check.
INTERNAL_SERVICE_TOKEN=dev-internal-token-change-me

RATE_LIMIT_ENABLED=true
# Prometheus listener, kept off the API port. Set to off to disable it.
METRICS_ADDR=127.0.0.1:9091
LOG_LEVEL=info
AUTO_MIGRATE=false

# Expired tokens and sessions are deleted on this cadence; 0 disables the sweep.
RETENTION_INTERVAL=1h
# Delivered outbox rows are kept this long for inspection.
RETENTION_OUTBOX_WINDOW=168h
